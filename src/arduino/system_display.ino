#include <U8g2lib.h>
#include <RTClib.h>
#include "DHT.h"
#include <EEPROM.h>

/*
  SISTEMA - Display Gráfico 128x64
  - DHT11 no pino 2
  - LDR no pino A0
  - Display ST7920 128x64 (software SPI: EN=13, RW=11, RS=10)
  - Joystick VRx=A2 VRy=A3 SW=7
  - LEDs: verde=5, amarelo=4, vermelho=3
  - Buzzer = 6
  - Menu aparece somente se T, U e L estiverem OK
  - Se alguma medida errada -> mostra apenas a(s) medida(s) errada(s)
  - LED amarelo pisca 3x (ALERTA) | LED vermelho + buzzer (CRÍTICO)
  - Scroll do menu apenas 1x por sessão de "tudo OK"
*/

// -------- definições de hardware --------
#define DHTPIN 2
#define DHTTYPE DHT11
DHT dht(DHTPIN, DHTTYPE);

// Display ST7920 (software SPI)
U8G2_ST7920_128X64_1_SW_SPI u8g2(U8G2_R0, 13, 11, 10);

RTC_DS1307 rtc;

const int ledGreen = 5;
const int ledYellow = 4;
const int ledRed = 3;
const int buzzer = 6;

const int joyVert = A3;  // navegação (cima/baixo)
const int joyHorz = A2;  // edição (esq/dir)
const int joySW   = 7;   // CORRIGIDO: era 7, agora é 9

const int ldrPin  = A0;

// Offset de fuso horário para Brasília (UTC-3)
const int TIMEZONE_OFFSET = -3;

// -------- limites exatos --------
const float tempMin = 12;
const float tempMax = 30;
const int   umidMin = 60; 
const int   umidMax = 80;
const int   lumMin  = 0;
const int   lumMax  = 80;

// -------- EEPROM --------
const int EEPROM_ADDR_TEMP = 0;
const int EEPROM_ADDR_HUM  = EEPROM_ADDR_TEMP + sizeof(float);
const int EEPROM_ADDR_LUM  = EEPROM_ADDR_HUM + sizeof(float);
const int EEPROM_ADDR_FLAG = EEPROM_ADDR_LUM + sizeof(int);
const byte EEPROM_FLAG_VALUE = 0x5A;

// -------- variáveis --------
float tempC = -999.0;
float hum   = -1.0;
int   lum   = 0;

bool tudoOk = false;
int  menuIndex = 0;
unsigned long lastDebounce = 0;
const unsigned long debounceDelay = 200UL;

unsigned long lastDHTreadMillis = 0;
const unsigned long DHT_INTERVAL = 2000UL;

bool menuIntroShown = false; // controla o scroll 1x

const char HAPPY_FACE[] = ":)";
const char SAD_FACE[]   = ":(";

void drawStatusLine(int y, const char *text) {
  const int textX = 5;
  u8g2.drawUTF8(textX, y, text);
}

